# Cổng chạy server backend
PORT=8087

# Domain FE được phép gọi API (CORS). KHÔNG để "*" ở production, phải set domain cụ thể.
CORS_ORIGIN=http://localhost:3000

# Secret dùng để ký/verify JWT. Đặt chuỗi ngẫu nhiên đủ mạnh khi deploy, không dùng giá trị mẫu.
JWT_SECRET=<đặt-chuỗi-ngẫu-nhiên-khi-deploy>
