# Cổng chạy server backend
PORT=8087

# Domain FE được phép gọi API (CORS). KHÔNG để "*" ở production, phải set domain cụ thể.
CORS_ORIGIN=http://localhost:3000

# Secret dùng để ký/verify JWT. Đặt chuỗi ngẫu nhiên đủ mạnh khi deploy, không dùng giá trị mẫu.
JWT_SECRET=<đặt-chuỗi-ngẫu-nhiên-khi-deploy>

# Cấu hình SMTP gửi email thông báo. Để trống = dùng Ethereal test (hộp thư test tự tạo, không gửi được cho người dùng thật).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Cấu hình Zalo OA gửi thông báo qua Zalo. Để trống = bỏ qua gửi Zalo (chưa có token thật).
ZALO_OA_ID=
ZALO_OA_TOKEN=
